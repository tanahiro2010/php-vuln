# Hifumi Secure Shop -- MySQL server config (training).
# Bind-mounted into the mysql container at /etc/mysql/conf.d/my.cnf.
# Kept minimal on purpose; nothing here changes SQLi behaviour, it just
# makes the local training instance run cleanly (utf8mb4, permissive
# GROUP BY, no strict mode) so demo payloads never blow up on syntax
# rules unrelated to the lesson.

[mysqld]
character-set-server        = utf8mb4
collation-server            = utf8mb4_unicode_ci

# Loosen ONLY_FULL_GROUP_BY / STRICT_TRANS_TABLES so demo INSERTs and
# ad-hoc UNION queries don't error on unrelated pedantic checks.
sql_mode                    = "NO_ENGINE_SUBSTITUTION"

# Small footprint -- this box only serves a handful of demo rows.
max_connections             = 50
innodb_buffer_pool_size     = 128M

# Log slow queries (>= 1s) so a lecturer can point at a real Time-based
# blind demo if they extend the training (SLEEP() in MySQL is a genuine
# blind-SQLi primitive, unlike SQLite where we had to fake it).
slow_query_log              = 1
long_query_time             = 1

[client]
default-character-set       = utf8mb4
